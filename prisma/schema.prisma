generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Property {
  idProperty      Int              @id @default(autoincrement()) @map("id_property")
  description     String
  price           Int
  type            PropertyTypeEnum
  category        OperationEnum
  address         String
  ubication       String?
  city            String?
  surface         Int
  bedrooms        Int?
  bathrooms       Int?
  garage          Int?
  floors          Int?
  constructedArea Int?             @map("constructed_area")
  services        ServiceEnum[]
  images          Image[]
  slug            String           @unique

  @@map("property")
}

model Admin {
  idAdmin       Int    @id @default(autoincrement()) @map("id_admin")
  adminEmail    String @map("admin_email") @db.VarChar(255)
  adminPassword String @map("admin_password") @db.VarChar(255)

  @@map("admin")
}

model Image {
  idImage    Int       @id @default(autoincrement()) @map("id_image")
  url        String?
  alt_text   String?
  position   Int
  isMain     Boolean   @map("is_main")
  idProperty Int?      @map("id_property")
  property   Property? @relation(fields: [idProperty], references: [idProperty], onDelete: Cascade, map: "fk_image_propery")

  @@map("image")
}

enum PropertyTypeEnum {
  casa
  departamento
  campo
  local_comercial
  lote

  @@map("property_type_enum")
}

enum OperationEnum {
  alquiler
  venta

  @@map("operation_enum")
}

enum ServiceEnum {
  agua
  luz
  gas
  internet
  cloacas

  @@map("service_enum")
}
